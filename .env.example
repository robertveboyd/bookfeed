# Bookfeed — local secrets template
# Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Never commit `.env.local` or real secrets.

# Auth.js / NextAuth (credentials provider)
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Local default; use your real URL in Vercel Production / Preview
AUTH_URL=http://localhost:3000

# Database (Neon)
# Add connection string variable name(s) from the Neon dashboard when the
# project is created — follow Neon's recommended env naming for Next.js / Drizzle.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
